   "source": [
    "import pandas as pd\n",
    "from sklearn.datasets import load_wine\n",
    "\n",
    "# Load dataset\n",
    "wine = load_wine()\n",
    "data = pd.DataFrame(wine.data, columns=wine.feature_names)\n",
    "\n",
    "# Save to CSV\n",
    "data.to_csv(\"wine_dataset.csv\", index=False)\n",
    "\n",
    "print(\"CSV file created: wine_dataset.csv\")"
   ]
  },
